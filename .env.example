# PostgreSQL
DB_HOST=localhost
DB_PORT=15432
DB_NAME=identity_service_db
DB_USERNAME=identity_service_user
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=16379
REDIS_PASSWORD=your_redis_password_here

# Server
SERVER_PORT=8080

# JWT Signing Keys (Base64-encoded RSA)
JWT_SIGNING_PRIVATE_KEY=your_base64_encoded_private_key_here
JWT_SIGNING_PUBLIC_KEY=your_base64_encoded_public_key_here
JWT_SIGNING_KID=identity-service-key-1

# Logging
LOG_LEVEL=DEBUG
LOG_SECURITY_LEVEL=DEBUG
